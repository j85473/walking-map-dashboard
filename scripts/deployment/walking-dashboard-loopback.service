[Unit]
Description=Proxy Walking Dashboard loopback requests to its Tailscale listener
After=network-online.target walking-dashboard.service

[Service]
ExecStart=/usr/lib/systemd/systemd-socket-proxyd --exit-idle-time=60s 100.107.116.123:3005
DynamicUser=true
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
RestrictAddressFamilies=AF_INET AF_INET6
