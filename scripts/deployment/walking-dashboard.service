[Unit]
Description=Walking Dashboard on M70
Wants=network-online.target
After=network-online.target tailscaled.service postgresql.service
ConditionPathExists=/etc/walking-dashboard/runtime.env

[Service]
Type=simple
User=walking-dashboard
Group=walking-dashboard
WorkingDirectory=/opt/walking-dashboard
Environment=PATH=/usr/local/bin:/usr/bin:/bin
Environment=NODE_ENV=production
EnvironmentFile=/etc/walking-dashboard/runtime.env
ExecStart=/usr/local/bin/node node_modules/next/dist/bin/next start -H 100.107.116.123 -p 3005
Restart=always
RestartSec=10
SuccessExitStatus=130 143
TimeoutStopSec=30
KillMode=control-group
UMask=0077
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
